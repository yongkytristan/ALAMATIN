# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# JavaScript / web
node_modules/
.next/
coverage/

# Internal data repository: governed source, interim, and processed artifacts
# are intentionally tracked here. This policy must never be copied to the
# public ALAMATIN repository.
data/private/**
!data/private/.gitkeep

# Models and large artifacts
models/
checkpoints/
artifacts/
*.bin
*.ckpt
*.joblib
*.onnx
*.pt
*.pth
*.safetensors

# Raw third-party downloads (e.g. OSM Geofabrik snapshots): large binary
# extracts, never committed. Governance manifests alongside them (small
# JSON, e.g. acquisition-manifest.json) are intentionally still tracked.
*.osm.pbf
*.pbf

# Local tooling and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
